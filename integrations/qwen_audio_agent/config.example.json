{
  "image": "docker.v2.aispeech.com/sjtu/sjtu_yukai-tau-qwen-agent:0.3.1",
  "environment": {
    "OPENAI_API_KEY": "GAIA2_BACKEND_API_KEY",
    "OPENAI_BASE_URL": "GAIA2_BACKEND_API_BASE",
    "OPENAI_MODEL": "GAIA2_BACKEND_MODEL",
    "QWEN_AUDIO_REALTIME_API_KEY": "DASHSCOPE_API_KEY3"
  },
  "boot_timeout_seconds": 120,
  "tool_timeout_seconds": 120,
  "max_buffer_seconds": 1200,
  "asr_model": "mimo-v2.5-asr",
  "asr_api_key_env": "MIMO_API_KEY",
  "config_env_file": "/hpc_stor03/sjtu_home/chaolei.liu/.config/qwaudio/config.env",
  "asr_provider": "mimo",
  "tts": {
    "model_id": "mimo-v2.5-tts",
    "api_key_env": "MIMO_API_KEY",
    "voices": {
      "gaia2_male": "Dean",
      "gaia2_female": "Chloe"
    }
  },
  "asr_hotwords": {
    "enabled": false,
    "weight": 4,
    "max_terms": 2000
  },
  "user_llm_api_key_env": "MIMO_API_KEY",
  "user_llm_base_url_env": "MIMO_BASE_URL",
  "user_llm_model_env": "MIMO_MODEL"
}
