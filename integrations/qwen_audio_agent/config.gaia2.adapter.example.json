{
  "image": "docker.v2.aispeech.com/sjtu/sjtu_yukai-tau-qwen-agent:0.3.1",
  "config_env_file": "config.env",
  "environment": {
    "QWEN_AUDIO_REALTIME_API_KEY": "QWEN_AUDIO_REALTIME_API_KEY",
    "QWEN_AUDIO_REALTIME_PROVIDER": "QWEN_AUDIO_REALTIME_PROVIDER",
