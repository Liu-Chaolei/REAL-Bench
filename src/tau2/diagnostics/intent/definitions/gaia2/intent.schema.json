          "description": "对象自身的时间属性，如晚餐开始时间。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "description": "固定结构标签。",
              "const": "entity_time"
            },
            "entity_ref": {
              "description": "提供时间的已声明对象 ID。",
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "field": {
              "description": "开放的时间语义属性，如 start_datetime。",
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "entity_ref",
            "field"
          ]
        },
        {
          "description": "输入明确提供的绝对日期或日期时间。保留精度和明确时区；不补缺失时区或秒，不从主机环境推断。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "description": "固定结构标签。",
              "const": "absolute_time"
            },
            "value": {
              "description": "ISO 日期 YYYY-MM-DD，或日期时间 YYYY-MM-DDTHH:MM[:SS]，日期时间可带明确 Z 或 ±HH:MM 偏移。",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)?)?$"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "$ref": "#/$defs/undetermined"
        }
      ]
    }
