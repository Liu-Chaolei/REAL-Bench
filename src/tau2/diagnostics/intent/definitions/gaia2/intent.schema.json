          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "数量模式 exactly；只保存该模式需要的参数。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "固定数量模式；any_one 仅用于明确允许任意选择一个，不从缺少名称推断。",
              "const": "exactly"
