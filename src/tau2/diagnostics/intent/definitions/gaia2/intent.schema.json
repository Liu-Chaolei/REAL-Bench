    "temporal_anchor": {
      "description": "统一的时间来源结构。仅保存原文及允许上下文所支持的基准；真实基准歧义使用 undetermined 和 ambiguities。",
      "oneOf": [
        {
          "description": "本次 USER 请求的时点，不取主机当前日期。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "description": "固定结构标签。",
              "const": "user_request"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "某规则声明的外部触发事件发生时点。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "description": "固定结构标签。",
              "const": "rule_trigger"
            },
            "rule_ref": {
              "description": "声明 trigger 的规则 ID。跨规则基准须是原文明确的引用。",
