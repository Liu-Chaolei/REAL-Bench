              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "#/$defs/entity_field"
                },
                {
                  "$ref": "#/$defs/trigger_field"
                },
                {
                  "$ref": "#/$defs/undetermined"
                }
              ]
            }
          },
          "required": [
            "mode",
            "count"
          ]
        },
        {
          "description": "数量模式 at_least；只保存该模式需要的参数。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "固定数量模式；any_one 仅用于明确允许任意选择一个，不从缺少名称推断。",
              "const": "at_least"
            },
            "count": {
              "description": "对象数量：明确非负整数，或从对象/未来事件读取的动态数量。真实歧义用 undetermined 并记录 ambiguities；不从隐藏状态推算数量。",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "#/$defs/entity_field"
                },
                {
                  "$ref": "#/$defs/trigger_field"
                },
                {
                  "$ref": "#/$defs/undetermined"
                }
              ]
            }
          },
          "required": [
            "mode",
            "count"
          ]
        },
        {
          "description": "数量模式 at_most；只保存该模式需要的参数。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "固定数量模式；any_one 仅用于明确允许任意选择一个，不从缺少名称推断。",
              "const": "at_most"
            },
            "count": {
              "description": "对象数量：明确非负整数，或从对象/未来事件读取的动态数量。真实歧义用 undetermined 并记录 ambiguities；不从隐藏状态推算数量。",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "#/$defs/entity_field"
                },
                {
                  "$ref": "#/$defs/trigger_field"
                },
                {
                  "$ref": "#/$defs/undetermined"
                }
              ]
            }
          },
          "required": [
            "mode",
            "count"
          ]
        },
        {
          "description": "数量模式 range；只保存该模式需要的参数。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "固定数量模式；any_one 仅用于明确允许任意选择一个，不从缺少名称推断。",
              "const": "range"
            },
            "min_count": {
              "description": "对象数量：明确非负整数，或从对象/未来事件读取的动态数量。真实歧义用 undetermined 并记录 ambiguities；不从隐藏状态推算数量。",
              "oneOf": [
                {
                  "type": "integer",
