# Speech frontend remains on Ali. GPT inference uses an independent credential.
DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_PROVIDER=dashscope
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_AUDIO_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# Use the Responses base URL and API key provided by your GPT service.
GPT_API_BASE_URL=
GAIA2_BACKEND_API_KEY=
GAIA2_BACKEND_REASONING_EFFORT=low
QWEN_AUDIO_AGENT_BACKEND_MODEL=openai/gpt-6-astra
OPENCODE_CONFIG_CONTENT={"model":"openai/gpt-6-astra","small_model":"openai/gpt-6-astra","provider":{"openai":{"npm":"@ai-sdk/openai","options":{"baseURL":"${GPT_API_BASE_URL}","apiKey":"${GAIA2_BACKEND_API_KEY}"},"models":{"gpt-6-astra":{"name":"GPT-6 Astra","reasoning":true,"temperature":false,"tool_call":true,"limit":{"context":1050000,"output":128000},"options":{"reasoningEffort":"${GAIA2_BACKEND_REASONING_EFFORT}"}}}}}}

GAIA2_JUDGE_API=responses
GAIA2_JUDGE_MODEL=gpt-6-astra
GAIA2_JUDGE_PROVIDER=openai
GAIA2_JUDGE_ENDPOINT=${GPT_API_BASE_URL}
GAIA2_JUDGE_REASONING_EFFORT=low
GAIA2_JUDGE_API_KEY=${GAIA2_BACKEND_API_KEY}
