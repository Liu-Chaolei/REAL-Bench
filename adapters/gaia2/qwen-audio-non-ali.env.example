# Non-Ali profile. No model calls can start until the service fields are filled.
QWEN_AUDIO_REALTIME_PROVIDER=speech-to-speech
# A running speech-to-speech server, reachable from the Docker containers.
SPEECH_TO_SPEECH_REALTIME_URL=
SPEECH_TO_SPEECH_AUTH_TOKEN=

# Preserve an explicit OpenCode provider/model, e.g. local/my-model.
QWEN_AUDIO_AGENT_BACKEND_MODEL=
GAIA2_BACKEND_API_KEY=
# Optional OpenCode JSON for a custom compatible API. Example (single line):
# OPENCODE_CONFIG_CONTENT={"provider":{"local":{"npm":"@ai-sdk/openai-compatible","options":{"baseURL":"http://model-host:8000/v1","apiKey":"${GAIA2_BACKEND_API_KEY}"},"models":{"my-model":{"name":"my-model"}}}}}
OPENCODE_CONFIG_CONTENT=

# "openai" selects an API protocol adapter, not a cloud vendor.
# The endpoint below decides which service is contacted.
GAIA2_JUDGE_PROVIDER=openai
GAIA2_JUDGE_ENDPOINT=
GAIA2_JUDGE_MODEL=
# For a server without authentication, a nonempty placeholder such as EMPTY
# satisfies the compatible SDK; otherwise supply that service's real key.
GAIA2_JUDGE_API_KEY=
