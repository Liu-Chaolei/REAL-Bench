# Agent settings. Supplier connections live in config.env.
QWEN_AUDIO_REALTIME_PROVIDER='${QWEN_AUDIO_PROVIDER}'
QWEN_AUDIO_REALTIME_MODEL='${QWEN_AUDIO_MODEL}'
QWEN_AUDIO_REALTIME_BASE_URL='${QWEN_AUDIO_BASE_URL}'
DASHSCOPE_API_KEY=<REDACTED>
GAIA2_BACKEND_MODEL='${DEEPSEEK_MODEL}'
GAIA2_BACKEND_API_BASE='${DEEPSEEK_BASE_URL}'
GAIA2_BACKEND_API_KEY=<REDACTED>
GAIA2_BACKEND_REASONING_EFFORT='low'
QWEN_AUDIO_AGENT_BACKEND_MODEL='openai/${GAIA2_BACKEND_MODEL}'
OPENCODE_CONFIG_CONTENT='{
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "${GAIA2_BACKEND_API_BASE}",
        "apiKey": "<REDACTED>"
      },
      "models": {
        "${GAIA2_BACKEND_MODEL}": {
          "name": "${GAIA2_BACKEND_MODEL}",
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "${GAIA2_BACKEND_REASONING_EFFORT}"
          }
        }
      }
    }
  },
  "model": "openai/${GAIA2_BACKEND_MODEL}",
  "small_model": "openai/${GAIA2_BACKEND_MODEL}"
}'
